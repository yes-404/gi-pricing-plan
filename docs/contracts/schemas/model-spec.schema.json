{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/model-spec.schema.json",
  "title": "ModelSpec",
  "description": "Complete pre-fit description of a model. Tagged union on model_type. See 02-modelling.md §4.4.",
  "type": "object",
  "required": ["model_family_slug", "dataset_version_id", "response", "factors", "seed", "model_type"],
  "properties": {
    "model_family_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "dataset_version_id": {"type": "string", "format": "uuid"},
    "split_ref": {
      "type": ["object", "null"],
      "required": ["split_artifact_id", "train_part", "holdout_part"],
      "properties": {
        "split_artifact_id": {"type": "string", "format": "uuid"},
        "train_part": {"type": "string"},
        "holdout_part": {"type": "string"}
      }
    },
    "peril": {"type": ["string", "null"]},
    "response": {"enum": ["claim_count", "claim_severity", "burning_cost", "retention", "conversion", "elasticity"]},
    "response_column": {"type": "string"},
    "offset": {
      "type": ["object", "null"],
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "log_column", "column", "model"]},
        "column": {"type": ["string", "null"]},
        "offset_model_ref": {
          "anyOf": [
            {"type": "string", "pattern": "^model:[a-z0-9][a-z0-9-]{1,62}@[1-9][0-9]*$"},
            {"type": "null"}
          ]
        }
      }
    },
    "weight": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "column"]},
        "column": {"type": ["string", "null"]}
      }
    },
    "factors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factor_id", "factor_version"],
        "properties": {
          "factor_id": {"type": "string", "format": "uuid"},
          "factor_version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "filter": {"type": ["string", "null"]},
    "seed": {"type": "integer"},
    "model_type": {"enum": ["glm", "xgboost", "lightgbm", "ebm"]}
  },
  "allOf": [
    {
      "if": {"properties": {"model_type": {"const": "glm"}}, "required": ["model_type"]},
      "then": {
        "required": ["family", "link"],
        "properties": {
          "family": {"enum": ["poisson", "negative_binomial", "gamma", "inverse_gaussian", "tweedie", "binomial", "gaussian"]},
          "family_params": {"type": "object",
            "properties": {"power": {"type": "number", "exclusiveMinimum": 1, "exclusiveMaximum": 2}}},
          "link": {"enum": ["log", "logit", "identity", "inverse", "power"]},
          "regularisation": {
            "type": ["object", "null"],
            "properties": {
              "kind": {"enum": ["none", "l1", "l2", "elastic_net"]},
              "alpha": {"type": "number", "minimum": 0},
              "l1_ratio": {"type": "number", "minimum": 0, "maximum": 1},
              "select_by": {"enum": ["fixed", "cv"]},
              "cv_folds": {"type": "integer", "minimum": 2}
            }
          },
          "custom_objective_ref": {"type": ["string", "null"]},
          "max_iter": {"type": "integer", "minimum": 1},
          "tolerance": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"model_type": {"enum": ["xgboost", "lightgbm"]}}, "required": ["model_type"]},
      "then": {
        "required": ["backend", "objective", "hyperparameters", "early_stopping"],
        "properties": {
          "backend": {"enum": ["xgboost", "lightgbm"]},
          "objective": {
            "type": "object",
            "required": ["kind"],
            "oneOf": [
              {"properties": {"kind": {"const": "builtin"}, "name": {"type": "string"}}, "required": ["kind", "name"]},
              {"properties": {"kind": {"const": "custom"}, "ref": {"$ref": "common/artifact-ref.schema.json"}}, "required": ["kind", "ref"]}
            ]
          },
          "base_margin": {
            "type": ["object", "null"],
            "properties": {
              "kind": {"enum": ["none", "log_column", "column"]},
              "column": {"type": ["string", "null"]}
            },
            "description": "Exposure offset for count objectives; required or explicitly acknowledged (FR-MODEL-27)."
          },
          "monotone_constraints": {
            "oneOf": [
              {"const": "derived_from_factors"},
              {"type": "object", "additionalProperties": {"enum": [-1, 0, 1]}}
            ]
          },
          "interaction_constraints": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
          "hyperparameters": {"type": "object"},
          "early_stopping": {
            "type": "object",
            "required": ["on", "metric", "rounds"],
            "properties": {
              "on": {"enum": ["holdout", "cv"], "description": "Never 'train' (FR-MODEL-30)."},
              "metric": {"type": "string"},
              "rounds": {"type": "integer", "minimum": 1}
            }
          },
          "categorical_handling": {"enum": ["native", "grouping", "one_hot"]},
          "backend_params": {"type": "object"},
          "eval_metrics": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  ]
}
