{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/custom-objective.schema.json",
  "title": "CustomObjective",
  "description": "Named, versioned, approvable loss definition. See 02-modelling.md §4.5 and §4.6.",
  "type": "object",
  "required": ["kind", "applicability"],
  "properties": {
    "kind": {"enum": ["template", "expression"]},
    "status": {"enum": ["draft", "certified", "review", "approved", "deprecated"]},
    "applicability": {
      "type": "object",
      "required": ["responses", "backends", "offset_required"],
      "properties": {
        "responses": {"type": "array", "minItems": 1,
          "items": {"enum": ["claim_count", "claim_severity", "burning_cost", "retention", "conversion"]}},
        "backends": {"type": "array", "minItems": 1, "items": {"enum": ["xgboost", "lightgbm", "glm"]}},
        "offset_required": {"type": "boolean"},
        "y_domain": {"type": "object",
          "properties": {"min_inclusive": {"type": "number"}, "max_inclusive": {"type": "number"}}}
      }
    },
    "certificate_id": {"type": ["string", "null"], "format": "uuid"}
  },
  "allOf": [
    {"$ref": "common/artifact-envelope.schema.json"},
    {
      "if": {"properties": {"kind": {"const": "template"}}, "required": ["kind"]},
      "then": {
        "required": ["template", "template_params"],
        "properties": {
          "template": {"enum": ["poisson", "gamma", "tweedie", "capped_gamma", "spliced_severity",
                                "asymmetric_squared", "asymmetric_poisson", "huber", "pseudo_huber",
                                "quantile", "zero_inflated_poisson", "focal_binomial"]},
          "template_params": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "expression"}}, "required": ["kind"]},
      "then": {
        "required": ["bound_symbols", "parameters", "loss", "derived", "hessian_strategy"],
        "properties": {
          "bound_symbols": {"type": "array", "items": {"enum": ["y", "f", "w"]}},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "default", "min", "max"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"},
                "type": {"enum": ["float", "int"]},
                "default": {"type": "number"},
                "min": {"type": "number"},
                "max": {"type": "number"}
              }
            }
          },
          "loss": {"type": "string", "maxLength": 2000,
            "description": "Restricted grammar only (FR-MODEL-41); parsed by AST allow-list, never eval'd."},
          "derived": {
            "type": "object",
            "required": ["gradient", "hessian", "derivation_tool", "derivation_version", "derived_at"],
            "description": "Generated by the platform, never hand-written (FR-MODEL-40).",
            "properties": {
              "gradient": {"type": "string"},
              "hessian": {"type": "string"},
              "derivation_tool": {"type": "string"},
              "derivation_version": {"type": "string"},
              "derived_at": {"type": "string", "format": "date-time"}
            }
          },
          "hessian_strategy": {"enum": ["none", "clip_to_min", "abs", "gauss_newton"]},
          "hessian_min": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  ]
}
