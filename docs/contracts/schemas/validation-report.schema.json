{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/validation-report.schema.json",
  "title": "ValidationReport",
  "description": "Immutable result of one validation run. See 01-data-management.md §4.6.",
  "type": "object",
  "required": ["id", "dataset_version_id", "rule_set_id", "rule_set_version", "job_id",
               "started_at", "finished_at", "overall", "counts", "results"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "$comment": "Added 2026-08-24 (W32-11). `ValidationReport.id` is a required `UUID` on the model and this contract declared no `id` at all — found the day this slug first gained a generated side, by the comparison that gaining one switches on. The omission was never ambiguous: `dataset-version.schema.json` references `validation_report_id`, so a report demonstrably has identity. Declared directly rather than by composing the envelope, following `diagnostics` and `transparency-artifact`; composing it here would import the nine unbuilt envelope fields `ENVELOPE_GAP_IS_RECORDED_NOT_FIXED` records."
    },
    "dataset_version_id": {"type": "string", "format": "uuid"},
    "rule_set_id": {"type": "string", "format": "uuid"},
    "rule_set_version": {"type": "integer", "minimum": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "overall": {"enum": ["pass", "pass_with_warnings", "fail", "error"]},
    "counts": {
      "type": "object",
      "required": ["pass", "warn", "fail", "error", "skipped"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "warn": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "reference_dataset_version_id": {"type": ["string", "null"], "format": "uuid"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_slug", "rule_version", "layer", "severity", "outcome"],
        "properties": {
          "rule_id": {"type": "string", "format": "uuid"},
          "rule_slug": {"type": "string"},
          "rule_version": {"type": "integer", "minimum": 1},
          "layer": {"enum": ["structural", "referential", "actuarial_sanity", "distributional"]},
          "severity": {"enum": ["fail", "warn", "info"]},
          "outcome": {"enum": ["pass", "warn", "fail", "error", "skipped"]},
          "measured": {"type": ["object", "null"]},
          "threshold": {"type": ["object", "null"]},
          "affected_rows": {"type": ["integer", "null"], "minimum": 0},
          "affected_exposure_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "detail": {"type": "string"},
          "offending_sample": {
            "type": "array", "maxItems": 100,
            "items": {
              "type": "object", "minProperties": 1,
              "additionalProperties": {"type": ["string", "null"]},
              "$comment": "OQ-DATA-12, decided 2026-08-26: (b) — the item shape was written out by W6b-18. One object per offending row; property keys are column names; values are the cell value as string or null (None is distinct from \"\"). A column-level check emits {\"column\": <name>}."
            }
          },
          "evidence_blob": {"type": ["string", "null"]},
          "error_reason": {"type": ["string", "null"], "enum": ["timeout", "exception", "unavailable_dependency", null]},
          "acknowledgement": {
            "type": ["object", "null"],
            "required": ["user_id", "at", "justification"],
            "properties": {
              "user_id": {"type": "string", "format": "uuid"},
              "at": {"type": "string", "format": "date-time"},
              "justification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "invariants": [
    "overall == 'pass' iff counts.fail == 0 and counts.error == 0 and counts.warn == 0",
    "overall == 'pass_with_warnings' iff counts.fail == 0 and counts.error == 0 and every warn result has an acknowledgement (FR-DATA-17)"
  ]
}
