{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/rating-version.schema.json",
  "title": "RatingVersion",
  "description": "Immutable, fully-pinned deployable bundle. See 03-rating-engine.md §4.3.",
  "allOf": [{"$ref": "common/artifact-envelope.schema.json"}],
  "type": "object",
  "required": ["status", "algorithm_ref", "pins", "model_reference_mode", "effective_from", "change_summary"],
  "properties": {
    "status": {"enum": ["draft", "review", "approved", "live", "retired"]},
    "algorithm_ref": {"$ref": "common/artifact-ref.schema.json"},
    "pins": {
      "type": "object",
      "required": ["rate_tables", "models", "reference_tables"],
      "description": "Nothing resolves 'latest' at scoring time (03 R1, FR-237).",
      "properties": {
        "rate_tables": {"type": "array", "items": {"$ref": "common/artifact-ref.schema.json"}},
        "models": {"type": "array", "items": {"$ref": "common/artifact-ref.schema.json"}},
        "reference_tables": {"type": "array", "items": {"$ref": "common/artifact-ref.schema.json"}},
        "custom_objectives": {"type": "array", "items": {"$ref": "common/artifact-ref.schema.json"}},
        "sub_graphs": {"type": "array", "items": {"$ref": "common/artifact-ref.schema.json"},
                       "description": "The exact Sub-graph Versions the algorithm's mounts name (FR-217, WK-1250 Slice 2)."}
      }
    },
    "model_reference_mode": {"enum": ["exact", "approximation"]},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": ["string", "null"], "format": "date"},
    "bundle": {
      "type": ["object", "null"],
      "required": ["content_hash", "bytes", "compiled_at"],
      "properties": {
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "compiled_at": {"type": "string", "format": "date-time"},
        "blob_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "change_summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "properties": {
        "regression_suite_run_id": {"type": ["string", "null"], "format": "uuid"},
        "dislocation_run_id": {"type": ["string", "null"], "format": "uuid"},
        "gipp_check_id": {"type": ["string", "null"], "format": "uuid"},
        "optimisation_run_id": {"type": ["string", "null"], "format": "uuid"},
        "structural_diff_blob": {"type": ["string", "null"]},
        "golden_quotes": {
          "type": ["object", "null"],
          "description": "Added 2026-09-28 (WK-672 Slice 2, PL-1189): written once by the submit gate and never edited after (03 FR-260, §4.3). Either {status: checked, suite_ref, suite_content_hash, bundle_hash, results, delta} or {status: not_checked, regression_suite: none, message: 'no golden quotes were checked', reason}. The generated OpenAPI carries the full shape (GoldenQuoteCheck | GoldenQuoteNotChecked)."
        }
      }
    },
    "approval_request_id": {"type": ["string", "null"], "format": "uuid"}
  },
  "invariants": [
    "status >= approved requires every evidence item the workspace policy demands (FR-257, 06 §3.3)",
    "every pin resolves to an artifact whose status is approved or better (FR-20)",
    "bundle.content_hash is reproducible from the pins (NFR-495)"
  ]
}
