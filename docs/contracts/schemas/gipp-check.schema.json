{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/gipp-check.schema.json",
  "title": "GippCheck",
  "description": "FCA PS21/5 evidence: renewal price vs equivalent new business price. See 04-optimisation.md §4.3.",
  "type": "object",
  "required": ["rating_version_ref", "renewal_population_dataset_version_id", "policy_count",
               "method", "channel_mapping", "tolerance_pct", "distribution", "worst_case_ratio", "verdict"],
  "properties": {
    "rating_version_ref": {"$ref": "common/artifact-ref.schema.json"},
    "renewal_population_dataset_version_id": {"type": "string", "format": "uuid"},
    "policy_count": {"type": "integer", "minimum": 0},
    "method": {"const": "rescore_as_new_business",
      "description": "Each risk is scored twice through the same production bundle; no formula approximates the ENBP (04 §5.2)."},
    "channel_mapping": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["renewal_channel", "equivalent_nb_channel"],
        "properties": {
          "renewal_channel": {"type": "string"},
          "equivalent_nb_channel": {"type": "string"}
        }
      },
      "description": "Explicit, reviewed, documented — never inferred (OQ-OPT-6)."
    },
    "tolerance_pct": {"type": "number", "minimum": 0},
    "distribution": {"type": "array", "items": {"type": "object"}},
    "worst_case_ratio": {"type": "number", "minimum": 0},
    "verdict": {"enum": ["pass", "fail"]},
    "failing_population": {
      "type": "object",
      "properties": {
        "policies": {"type": "integer", "minimum": 0},
        "exposure_years": {"$ref": "common/money.schema.json#/$defs/Decimal"},
        "max_ratio": {"type": ["number", "null"]}
      }
    },
    "price_walking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tenure_years", "mean_price_over_technical"],
        "properties": {
          "tenure_years": {"type": "integer", "minimum": 0},
          "mean_price_over_technical": {"type": "number"}
        }
      }
    },
    "price_walking_finding": {"type": ["string", "null"]},
    "evidence_blob": {"type": ["string", "null"]}
  }
}
