{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/dislocation-run.schema.json",
  "title": "DislocationRun",
  "description": "Premium change between two Rating Versions over a fixed portfolio. A persisted, citable artifact, not a transient screen (03 FR-263, FR-264, FR-265, FR-266, §4.6).",
  "type": "object",
  "required": ["baseline_ref", "candidate_ref", "portfolio_dataset_version_id",
               "policy_count", "exposure_years", "totals", "distribution"],
  "dependentRequired": {"attribution": ["derived_changes", "change_groups", "attribution_summary"]},
  "properties": {
    "baseline_ref": {"$ref": "common/artifact-ref.schema.json"},
    "candidate_ref": {"$ref": "common/artifact-ref.schema.json"},
    "portfolio_dataset_version_id": {"type": "string", "format": "uuid"},
    "job_id": {"type": "string", "format": "uuid"},
    "policy_count": {"type": "integer", "minimum": 0},
    "exposure_years": {"$ref": "common/money.schema.json#/$defs/Decimal"},
    "totals": {
      "type": "object",
      "required": ["baseline_premium_minor", "candidate_premium_minor", "change_pct"],
      "properties": {
        "baseline_premium_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "candidate_premium_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "change_pct": {"type": "number"}
      }
    },
    "distribution": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["band", "policies", "exposure_share", "mean_change_pct"],
        "properties": {
          "band": {"type": "string"},
          "policies": {"type": "integer", "minimum": 0},
          "exposure_share": {"type": "number", "minimum": 0, "maximum": 1},
          "mean_change_pct": {"type": "number"}
        }
      }
    },
    "by_segment": {
      "type": "array",
      "description": "Sliceable by any factor available on the portfolio dataset (FR-264).",
      "items": {
        "type": "object",
        "required": ["factor", "level", "policies", "mean_change_pct"],
        "properties": {
          "factor": {"type": "string"},
          "level": {"type": "string"},
          "policies": {"type": "integer", "minimum": 0},
          "mean_change_pct": {"type": "number"},
          "exposure_share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "by_ladder_rung": {
      "type": "array",
      "description": "Which part of the change caused this, not merely how much it changed (FR-264).",
      "items": {
        "type": "object",
        "required": ["rung", "contribution_pct"],
        "properties": {"rung": {"type": "string"}, "contribution_pct": {"type": "number"}}
      }
    },
    "attribution": {
      "type": "array",
      "description": "Per change group: the Shapley part of record and the isolated and cumulative views, in integer minor units (FR-266 as amended, RW1).",
      "items": {
        "type": "object",
        "required": ["group", "shapley_minor", "isolated_minor", "cumulative_minor", "mean_change_pct"],
        "properties": {
          "group": {"type": "string"},
          "shapley_minor": {"anyOf": [{"$ref": "common/money.schema.json#/$defs/MoneyMinor"}, {"type": "null"}]},
          "isolated_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
          "cumulative_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
          "mean_change_pct": {"type": "number"},
          "cumulative_change_pct": {"type": "number"}
        }
      }
    },
    "derived_changes": {
      "type": "array",
      "description": "The changes derived from baseline and candidate at step granularity (RW3).",
      "items": {
        "type": "object",
        "required": ["id", "kind", "description"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["pin", "step_added", "step_removed", "step_changed", "table_repointed"]},
          "description": {"type": "string"}
        }
      }
    },
    "change_groups": {
      "type": "array", "maxItems": 6,
      "description": "The analyst's groups, partitioning derived_changes exactly (RW3). Their order is the declared change order.",
      "items": {
        "type": "object",
        "required": ["name", "changes"],
        "properties": {
          "name": {"type": "string"},
          "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "attribution_summary": {
      "type": "object",
      "description": "Method, totals, S and R, and the subset bundles compiled (FR-266 as amended, RW1, RW2).",
      "required": ["method", "total_change_minor", "residual_minor", "order_sensitivity_lower_bound",
                   "residual_share", "orders_sampled", "subset_bundle_count", "subset_bundle_hashes",
                   "subset_valuation", "replay_fell_back"],
      "properties": {
        "method": {"enum": ["shapley", "order_dependent"]},
        "total_change_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "residual_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "order_sensitivity_lower_bound": {"anyOf": [{"$ref": "common/money.schema.json#/$defs/Decimal"}, {"type": "null"}]},
        "residual_share": {"anyOf": [{"$ref": "common/money.schema.json#/$defs/Decimal"}, {"type": "null"}]},
        "orders_sampled": {"type": ["integer", "null"], "minimum": 2},
        "subset_bundle_count": {"type": "integer", "minimum": 0},
        "subset_bundle_hashes": {"type": "array", "items": {"type": "string"}},
        "subset_valuation": {"enum": ["rerate", "ladder_replay"]},
        "replay_fell_back": {"type": "boolean"}
      }
    },
    "largest_movers_blob": {"type": ["string", "null"],
      "description": "Drill-down to individual quotes and their traces."},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "count"],
        "properties": {
          "code": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "sample": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
