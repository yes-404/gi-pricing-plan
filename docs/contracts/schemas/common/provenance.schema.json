{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/common/provenance.schema.json",
  "title": "Provenance",
  "description": "Traceability stamp for any displayed figure (FR-OVR-3).",
  "type": "object",
  "required": ["entity_type", "entity_id"],
  "properties": {
    "entity_type": {"type": "string"},
    "entity_id": {"type": "string", "format": "uuid"},
    "version": {"type": "integer", "minimum": 1},
    "produced_by_job_id": {"type": ["string", "null"], "format": "uuid"},
    "computed_at": {"type": "string", "format": "date-time"}
  }
}
