{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/common/blob-ref.schema.json",
  "title": "BlobRef",
  "description": "Content-addressed object reference (00-overview.md ID-4).",
  "type": "object",
  "required": ["sha256", "bytes", "media_type"],
  "properties": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string"},
    "part_count": {"type": ["integer", "null"], "minimum": 1,
      "description": "Null for a single-part blob; a part count only where the upload was multipart. Nullable since 2026-08-22 (W5), matching `BlobRef.part_count: int | None`."}
  }
}
