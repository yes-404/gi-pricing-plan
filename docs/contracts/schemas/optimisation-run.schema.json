{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/optimisation-run.schema.json",
  "title": "OptimisationRun",
  "description": "Constrained price optimisation. Proposes only; never deploys (04 R1). See 04-optimisation.md §4.1.",
  "allOf": [{"$ref": "common/artifact-envelope.schema.json"}],
  "type": "object",
  "required": ["portfolio_dataset_version_id", "baseline_rating_version_ref", "objective",
               "decision_variable", "demand_models", "constraints", "seed"],
  "properties": {
    "portfolio_dataset_version_id": {"type": "string", "format": "uuid"},
    "baseline_rating_version_ref": {"$ref": "common/artifact-ref.schema.json"},
    "objective": {
      "type": "object",
      "required": ["kind", "profit_definition"],
      "properties": {
        "kind": {"enum": ["expected_profit", "expected_volume", "expected_premium", "blend"]},
        "w_profit": {"type": "number", "minimum": 0, "maximum": 1},
        "w_volume": {"type": "number", "minimum": 0, "maximum": 1},
        "profit_definition": {"type": "string", "minLength": 1,
          "description": "Declared explicitly per run, never assumed (FR-OPT-9)."}
      }
    },
    "decision_variable": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["segment_factor", "rate_table_cells", "global_levers"]},
        "segment_factors": {"type": "array", "items": {"type": "string"}},
        "segment_count": {"type": "integer", "minimum": 1},
        "bounds": {
          "type": "object",
          "properties": {
            "min_factor": {"$ref": "common/money.schema.json#/$defs/Decimal"},
            "max_factor": {"$ref": "common/money.schema.json#/$defs/Decimal"}
          }
        }
      }
    },
    "demand_models": {
      "type": "object",
      "required": ["price_term"],
      "properties": {
        "conversion": {"$ref": "common/artifact-ref.schema.json"},
        "retention": {"$ref": "common/artifact-ref.schema.json"},
        "price_term": {"type": "string", "description": "Required on every demand model (FR-OPT-1)."}
      }
    },
    "constraints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["portfolio_premium_change", "segment_adjustment", "expected_volume",
                            "expected_loss_ratio", "minimum_premium", "smoothness", "monotonicity",
                            "gipp", "custom_linear"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "solver": {
      "type": "object",
      "required": ["name", "method", "tolerance", "max_iter"],
      "properties": {
        "name": {"type": "string"}, "method": {"type": "string"},
        "tolerance": {"type": "number"}, "max_iter": {"type": "integer", "minimum": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["method", "samples", "seed"],
      "properties": {
        "method": {"enum": ["monte_carlo", "delta_method", "none"]},
        "samples": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"}
      }
    },
    "seed": {"type": "integer"},
    "status": {"enum": ["queued", "running", "completed", "failed"]},
    "termination": {
      "type": ["object", "null"],
      "required": ["reason", "iterations", "seconds"],
      "properties": {
        "reason": {"enum": ["converged", "iteration_limit", "infeasible", "error"]},
        "iterations": {"type": "integer", "minimum": 0},
        "seconds": {"type": "number", "minimum": 0}
      },
      "description": "A non-converged run cannot be materialised without acknowledgement (FR-OPT-17)."
    },
    "result": {
      "type": ["object", "null"],
      "required": ["expected", "binding_constraints", "proposals"],
      "properties": {
        "expected": {"type": "object"},
        "binding_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "binding"],
            "properties": {
              "kind": {"type": "string"},
              "binding": {"type": "boolean"},
              "bound": {"type": "number"},
              "at_optimum": {"type": "number"},
              "shadow_price": {"type": "string"},
              "segments_at_bound": {"type": "integer", "minimum": 0}
            }
          },
          "description": "Every constraint reports binding or slack (04 R2, FR-OPT-12)."
        },
        "proposals": {"type": "array", "items": {"type": "object"}},
        "efficient_frontier": {"type": "array", "items": {"type": "object"}},
        "warnings": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
