{
  "$defs": {
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "`POST /api/v1/rate-tables/{slug}/seed-from-model` body (FR-230, `03` §5.1).\n\nOne seed request names one Factor of an approved model (`RL-1361` section A);\n`factor` is the Factor's slug, a key of the model's relativities. Exactly three\nfields, and an unknown field is refused (`RL-1375` DP-3).",
  "properties": {
    "change_note": {
      "title": "Change Note",
      "type": "string"
    },
    "factor": {
      "minLength": 1,
      "title": "Factor",
      "type": "string"
    },
    "model_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "model_ref",
    "factor",
    "change_note"
  ],
  "title": "SeedFromModelRequest",
  "type": "object"
}
