    "RoundSpec": {
      "additionalProperties": false,
      "description": "Explicit rounding for an `output` step (FR-226) — never implicit, never twice.",
      "properties": {
        "dp": {
          "minimum": 0,
          "title": "Dp",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "half_even",
            "half_up",
            "ceiling",
            "floor"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "dp"
      ],
      "title": "RoundSpec",
      "type": "object"
    },
    "SubGraphInputPort": {
      "additionalProperties": false,
      "description": "A declared input of a fragment: a name and a result type (never float, FR-227).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SubGraphInputPort",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The request body of `POST /api/v1/sub-graphs`: a body plus its slug.",
  "properties": {
    "change_note": {
      "minLength": 1,
      "title": "Change Note",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/SubGraphInputPort"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/AlgorithmOutput"
      },
      "title": "Outputs",
      "type": "array"
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Slug",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "constraint": "#/$defs/RatingConstraintStep",
            "expression": "#/$defs/RatingExpressionStep",
            "input": "#/$defs/RatingInputStep",
            "lookup": "#/$defs/RatingLookupStep",
            "model_call": "#/$defs/RatingModelCallStep",
            "output": "#/$defs/RatingOutputStep",
            "table": "#/$defs/RatingTableStep"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/RatingInputStep"
          },
          {
            "$ref": "#/$defs/RatingLookupStep"
          },
          {
            "$ref": "#/$defs/RatingTableStep"
          },
          {
            "$ref": "#/$defs/RatingExpressionStep"
          },
          {
            "$ref": "#/$defs/RatingModelCallStep"
          },
          {
            "$ref": "#/$defs/RatingConstraintStep"
          },
          {
            "$ref": "#/$defs/RatingOutputStep"
          }
        ]
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "inputs",
    "outputs",
    "steps",
    "change_note",
    "slug"
  ],
  "title": "SubGraphCreate",
  "type": "object"
}
