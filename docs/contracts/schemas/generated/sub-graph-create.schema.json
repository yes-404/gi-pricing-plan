{
  "$defs": {
    "AlgorithmOutput": {
      "additionalProperties": false,
      "description": "A declared output (FR-214): name, type, required flag.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "AlgorithmOutput",
      "type": "object"
    },
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    },
    "RatingConstraintStep": {
      "additionalProperties": false,
      "properties": {
        "clamp_bounds": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clamp Bounds"
        },
        "condition": {
          "title": "Condition",
          "type": "string"
        },
        "consumes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Consumes"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "on_violation": {
          "enum": [
            "clamp",
            "decline",
            "error"
          ],
          "title": "On Violation",
          "type": "string"
        },
        "produces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Produces"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "type": {
          "const": "constraint",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "label",
        "type",
        "condition",
        "on_violation",
        "reason_code"
      ],
      "title": "RatingConstraintStep",
      "type": "object"
    },
