{
  "$defs": {
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    },
    "SwitchReport": {
      "additionalProperties": false,
      "description": "Which processes switched to a Deployment and what became of each (`03` FR-268).\n\nThe `after` of the `deployment.switched` Audit Event and the switch half of the deploy\nresponse. Its terms (`receivers`, `committed`, `possibly_stale`, `pruned_stale`) are defined\nonce, in `03` §5.1's list of this Work's audit actions.",
      "properties": {
        "deployment_ref": {
          "description": "The Deployment (its id) the processes switch to.",
          "format": "uuid",
          "title": "Deployment Ref",
          "type": "string"
        },
        "processes": {
          "additionalProperties": {
            "enum": [
              "committed",
              "possibly_stale",
              "pruned_stale"
            ],
            "type": "string"
          },
          "description": "Each named process and what became of it.",
          "title": "Processes",
          "type": "object"
        },
        "receivers": {
          "description": "Live subscribers that received PREPARE.",
          "minimum": 0,
          "title": "Receivers",
          "type": "integer"
        }
      },
      "required": [
        "deployment_ref",
        "receivers",
        "processes"
      ],
      "title": "SwitchReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The `201` body of `POST /api/v1/environments/{env}/deployments`: the Deployment and,\nafter its transaction committed, the outcome of the switch (`03` FR-268).",
  "properties": {
    "bundle_hash": {
      "description": "The Rating Version's compiled Bundle hash (FR-239).",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Bundle Hash",
      "type": "string"
    },
    "deployed_at": {
      "format": "date-time",
      "title": "Deployed At",
      "type": "string"
    },
    "deployed_by": {
      "format": "uuid",
      "title": "Deployed By",
      "type": "string"
    },
    "deployment_request_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The approved Deployment Request executed; null only for a target with no `deployment` policy entry (RL-1301 A.5)."
    },
    "environment": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Environment",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "rating_version_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "switch": {
      "$ref": "#/$defs/SwitchReport"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "environment",
    "rating_version_ref",
    "bundle_hash",
    "deployed_by",
    "deployed_at",
    "reason",
    "switch"
  ],
  "title": "DeploymentCreated",
  "type": "object"
}
