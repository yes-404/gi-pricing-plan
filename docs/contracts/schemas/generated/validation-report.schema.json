{
  "$defs": {
    "Acknowledgement": {
      "additionalProperties": false,
      "description": "A Principal accepting a warning, on this report (FR-46, FR-47).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "at",
        "justification"
      ],
      "title": "Acknowledgement",
      "type": "object"
    },
    "OverallOutcome": {
      "enum": [
        "pass",
        "pass_with_warnings",
        "fail",
        "error"
      ],
      "title": "OverallOutcome",
      "type": "string"
    },
    "ReportCounts": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "minimum": 0,
          "title": "Error",
          "type": "integer"
        },
        "fail": {
          "minimum": 0,
          "title": "Fail",
          "type": "integer"
        },
        "pass": {
          "minimum": 0,
          "title": "Pass",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "warn": {
          "minimum": 0,
          "title": "Warn",
          "type": "integer"
        }
      },
      "required": [
        "pass",
        "warn",
        "fail",
        "error",
        "skipped"
      ],
      "title": "ReportCounts",
      "type": "object"
    },
    "RuleOutcome": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "error",
        "skipped"
      ],
      "title": "RuleOutcome",
      "type": "string"
    },
    "RuleResult": {
      "additionalProperties": false,
      "description": "One rule's outcome (`01` §4.6, FR-49).",
      "properties": {
        "acknowledgement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Acknowledgement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "affected_exposure_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Exposure Fraction"
        },
        "affected_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Rows"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "error_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Reason"
        },
        "layer": {
          "$ref": "#/$defs/ValidationLayer"
        },
        "measured": {
          "additionalProperties": true,
          "title": "Measured",
          "type": "object"
        },
        "offending_sample": {
          "default": [],
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "minProperties": 1,
            "type": "object"
          },
          "title": "Offending Sample",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/RuleOutcome"
        },
        "rule_id": {
          "format": "uuid",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_slug": {
          "title": "Rule Slug",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "threshold": {
          "additionalProperties": true,
          "title": "Threshold",
          "type": "object"
        }
      },
      "required": [
        "rule_id",
        "rule_slug",
        "rule_version",
        "layer",
        "severity",
        "outcome"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "Severity": {
      "description": "What a violation means. `warn` is not \"ignore\" — it needs an acknowledgement.",
      "enum": [
        "warn",
        "fail"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValidationLayer": {
      "description": "The four layers of FR-45, all of which a Rule Set must cover.",
      "enum": [
        "structural",
        "referential",
        "actuarial_sanity",
        "distributional"
      ],
      "title": "ValidationLayer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A report **as presented** (`01` §4.6): the artifact, plus the outcome derived from it.\n\nNever stored. The stored body is `ValidationReport`, and it stays free of both keys because\nit is the artifact (`ValidationReportRow`); `extra=\"forbid\"` there refuses this shape, so a\nview cannot be read back as a report. `overall` and `counts` are fields so the published\ncontract and the `01` §4.6 example hold them, and checked so neither is ever assigned.",
  "properties": {
    "counts": {
      "$ref": "#/$defs/ReportCounts"
    },
    "dataset_version_id": {
      "format": "uuid",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "empty_layers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ValidationLayer"
      },
      "title": "Empty Layers",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "overall": {
      "$ref": "#/$defs/OverallOutcome"
    },
    "reference_dataset_version_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Dataset Version Id"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleResult"
      },
      "title": "Results",
      "type": "array"
    },
    "rule_set_id": {
      "format": "uuid",
      "title": "Rule Set Id",
      "type": "string"
    },
    "rule_set_version": {
      "title": "Rule Set Version",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "dataset_version_id",
    "rule_set_id",
    "rule_set_version",
    "started_at",
    "finished_at",
    "overall",
    "counts"
  ],
  "title": "ValidationReportView",
  "type": "object"
}
