{
  "$defs": {
    "BlobRef": {
      "description": "A content-addressed object reference (ID-4).",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "part_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Count"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "DatasetKind": {
      "enum": [
        "ingested",
        "derived"
      ],
      "title": "DatasetKind",
      "type": "string"
    },
    "DatasetStatus": {
      "enum": [
        "draft",
        "validating",
        "validated",
        "failed",
        "archived"
      ],
      "title": "DatasetStatus",
      "type": "string"
    },
    "DatasetTable": {
      "additionalProperties": false,
      "description": "One table within a version (`01` §4.2).\n\n`_rejected` is a table like any other — the quarantine FR-32 requires, stored with\nthe version rather than discarded. A row that could not be parsed is evidence about the\nfeed, and throwing it away is how a broken upstream export goes unnoticed for a quarter.",
      "properties": {
        "arrow_schema": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Arrow Schema",
          "type": "object"
        },
        "blob": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^_?[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "pandera_schema_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pandera Schema Ref"
        },
        "primary_key": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Primary Key",
          "type": "array"
        },
        "record_grain": {
          "title": "Record Grain",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "source_names": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Normalised column name to the header it came from (FR-30). Kept because normalisation is lossy and occasionally surprising: freMTPL2's `IDpol` becomes `i_dpol`, since the splitter reads it as `I` + `Dpol` — the same rule that correctly gives `HTTPServer` → `http_server`. Without the original, a user cannot tell which of their columns a rule is talking about.",
          "title": "Source Names",
          "type": "object"
        }
      },
      "required": [
        "name",
        "record_grain",
        "row_count"
      ],
      "title": "DatasetTable",
      "type": "object"
    },
    "DerivedFrom": {
      "additionalProperties": false,
      "description": "How a derived version was produced from its parent (`01` §4.2, FR-73).\n\nOQ-DATA-13, decided 2026-08-26 (c): the object form replaces a bare dict so the\ndeclared operation's parameters are distinguishable from the identity of the parent —\nthe split that made version 7 from version 6 is not the same fact as which version\nthat was.",
      "properties": {
        "operation": {
          "enum": [
            "sample",
            "split",
            "filter",
            "union"
          ],
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "parent_version_id": {
          "format": "uuid",
          "title": "Parent Version Id",
          "type": "string"
        }
      },
      "required": [
        "parent_version_id",
        "operation"
      ],
      "title": "DerivedFrom",
      "type": "object"
    },
    "PeriodCovered": {
      "additionalProperties": false,
      "description": "The policy period the data covers (`01` §4.2).\n\nBoth ends are required and ordered — a version whose exposure window has no known\nend is one whose totals cannot be re-read against a calendar later. OQ-568,\ndecided 2026-08-26 (c): the object form replaces the model's scalar\n`period_from`/`period_to`, which could not carry an ordered pair as one fact.",
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "PeriodCovered",
      "type": "object"
    },
    "SourceFingerprint": {
      "additionalProperties": false,
      "description": "Provenance of the file or query the version was ingested from (`01` §4.2).\n\nOQ-DATA-13, decided 2026-08-26 (c): the object form replaces a bare `dict[str, str]`\nso `extracted_at` is required — a fingerprint without the moment it was taken cannot\nanswer \"was this file re-ingested after its contents changed?\".",
      "properties": {
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file_sha256",
            "query_hash",
            "asset_partition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "extracted_at"
      ],
      "title": "SourceFingerprint",
      "type": "object"
    },
    "VersionTotals": {
      "additionalProperties": false,
      "description": "The headline numbers, checked by validation and shown everywhere.\n\nMoney is integer minor units and exposure is a decimal string (FR-10): a float\nexposure total silently disagrees with the sum of its parts, and the disagreement is\nexactly the kind of thing an actuary is asked to explain.",
      "properties": {
        "claim_amount_minor": {
          "default": 0,
          "description": "Amount in minor units (pence/cents) of the workspace currency.",
          "title": "Claim Amount Minor",
          "type": "integer"
        },
        "claim_count": {
          "default": 0,
          "minimum": 0,
          "title": "Claim Count",
          "type": "integer"
        },
        "exposure_years": {
          "description": "Exact decimal as a string; never a binary float (FR-10).",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "title": "Exposure Years",
          "type": "string"
        }
      },
      "required": [
        "exposure_years"
      ],
      "title": "VersionTotals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable versioned snapshot of policy, claims and exposure data (`01` §4.2).",
  "properties": {
    "archived_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archived At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "currency": {
      "default": "GBP",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "derived_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/DerivedFrom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "ingestion_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingestion Run Id"
    },
    "kind": {
      "$ref": "#/$defs/DatasetKind",
      "default": "ingested"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "library_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Library Versions",
      "type": "object"
    },
    "parent_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "period_covered": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeriodCovered"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preparation_recipe_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preparation Recipe Id"
    },
    "profile_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Id"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Slug",
      "type": "string"
    },
    "source_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceFingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "status": {
      "$ref": "#/$defs/DatasetStatus"
    },
    "tables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DatasetTable"
      },
      "title": "Tables",
      "type": "array"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionTotals"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validation_report_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Report Id"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "slug",
    "version",
    "status",
    "created_at",
    "created_by",
    "updated_at",
    "dataset_id"
  ],
  "title": "DatasetVersion",
  "type": "object"
}
