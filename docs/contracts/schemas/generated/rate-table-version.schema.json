{
  "$defs": {
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    },
    "BlobRef": {
      "description": "A content-addressed object reference (ID-4).",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "part_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part Count"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "BulkOperationResult": {
      "additionalProperties": false,
      "description": "The outcome of a bulk operation (04 §4.4): what changed and what it created.",
      "properties": {
        "changed_cells": {
          "minimum": 0,
          "title": "Changed Cells",
          "type": "integer"
        },
        "new_version": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "changed_cells",
        "new_version"
      ],
      "title": "BulkOperationResult",
      "type": "object"
    },
    "FloorAndCapOperation": {
      "additionalProperties": false,
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "floor_and_cap",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/FloorAndCapParameters"
        },
        "result": {
          "$ref": "#/$defs/BulkOperationResult"
        }
      },
      "required": [
        "applied_to",
        "result",
        "kind",
        "parameters"
      ],
      "title": "FloorAndCapOperation",
      "type": "object"
    },
    "FloorAndCapParameters": {
      "additionalProperties": false,
      "description": "`floor_and_cap`'s parameters (04 §4.4): the clamp bounds, decimal strings.",
      "properties": {
        "cap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cap"
        },
        "floor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Floor"
        }
      },
      "required": [
        "floor",
        "cap"
      ],
      "title": "FloorAndCapParameters",
      "type": "object"
    },
    "ImportVerdict": {
      "additionalProperties": false,
      "description": "The source identity of a version created by import (03 §4.2, 03 §5.2).\n\n`round_trip` is the strict verdict: the file parsed back to exactly the cells it was\nexported from, so an import can never silently drop or re-type a cell. `applied_to`\nnames the addressed baseline version (the import endpoint addresses `{slug}@{version}`),\nso the seed-lineage inheritance check (03 §4.2) is expressible at save time and\nauditable after.",
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "round_trip": {
          "const": "passed",
          "title": "Round Trip",
          "type": "string"
        }
      },
      "required": [
        "filename",
        "content_sha256",
        "round_trip",
        "applied_to"
      ],
      "title": "ImportVerdict",
      "type": "object"
    },
    "ManualEdit": {
      "additionalProperties": false,
      "description": "The provenance of a version created by the manual-edit route (03 §4.2, RL-1555 item 2).\n\n`applied_to` names the base version edited, in `ImportVerdict.applied_to`'s form;\n`edited_cells` is the number of edits applied. It is what tells a hand-edited version\nfrom a re-seed.",
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "edited_cells": {
          "minimum": 1,
          "title": "Edited Cells",
          "type": "integer"
        }
      },
      "required": [
        "applied_to",
        "edited_cells"
      ],
      "title": "ManualEdit",
      "type": "object"
    },
    "RateTableCell": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "One rate table row in §4.2's form: key columns and the value column, every value a\nstring (a key level or a decimal string). RL-1475 item 2; FR-228's columns are data,\nso the keys are open and the value type is closed.",
      "title": "RateTableCell",
      "type": "object"
    },
    "RateTableKey": {
      "additionalProperties": false,
      "description": "A key column declaration (FR-228): name, type, optional Factor or Banding binding.\n\n`factor_ref` pins the Factor version the key is bound to (`RL-1361`); `banding_ref`\npins a Banding with no Factor. A key carries at most one of them, and a key with\nneither is joined by its own name.",
      "properties": {
        "banding_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "factor_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RateTableKeyType"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "RateTableKey",
      "type": "object"
    },
    "RateTableKeyType": {
      "description": "Valid types for a rate table key.",
      "enum": [
        "int",
        "string",
        "date",
        "bool"
      ],
      "title": "RateTableKeyType",
      "type": "string"
    },
    "RateTableStorageMode": {
      "description": "Storage mode for rate table cells (FR-232, 03 §3.3).\n\n`rows` is the default for small tables (< 250k cells); `parquet` is used\nfor larger tables. Once written, the storage mode is immutable with the version.",
      "enum": [
        "rows",
        "parquet"
      ],
      "title": "RateTableStorageMode",
      "type": "string"
    },
    "RateTableValue": {
      "additionalProperties": false,
      "description": "A value column declaration (FR-228): name, type, unit, optional bounds.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RateTableValueType"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "unit"
      ],
      "title": "RateTableValue",
      "type": "object"
    },
    "RateTableValueType": {
      "description": "Valid types for a rate table value (FR-228, 03 §3.3).",
      "enum": [
        "relativity",
        "money_minor",
        "percentage",
        "count"
      ],
      "title": "RateTableValueType",
      "type": "string"
    },
    "RebaseToLevelOperation": {
      "additionalProperties": false,
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "rebase_to_level",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/RebaseToLevelParameters"
        },
        "result": {
          "$ref": "#/$defs/BulkOperationResult"
        }
      },
      "required": [
        "applied_to",
        "result",
        "kind",
        "parameters"
      ],
      "title": "RebaseToLevelOperation",
      "type": "object"
    },
    "RebaseToLevelParameters": {
      "additionalProperties": false,
      "description": "`rebase_to_level`'s parameters (04 §4.4): the reference level that becomes 1.0.",
      "properties": {
        "base_level": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Base Level",
          "type": "object"
        }
      },
      "required": [
        "base_level"
      ],
      "title": "RebaseToLevelParameters",
      "type": "object"
    },
    "SeededFrom": {
      "additionalProperties": false,
      "description": "The seed origin of a rate table version (03 §4.2, FR-230).\n\nThe pinned source model reference and the timestamp at which the relativities were\nimported, so \"how far have we moved from the technical rate?\" is answerable by\ndiffing against this origin.",
      "properties": {
        "model_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "seeded_at": {
          "format": "date-time",
          "title": "Seeded At",
          "type": "string"
        }
      },
      "required": [
        "model_ref",
        "seeded_at"
      ],
      "title": "SeededFrom",
      "type": "object"
    },
    "UpliftByFilterOperation": {
      "additionalProperties": false,
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "uplift_by_filter",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/UpliftByFilterParameters"
        },
        "result": {
          "$ref": "#/$defs/BulkOperationResult"
        }
      },
      "required": [
        "applied_to",
        "result",
        "kind",
        "parameters"
      ],
      "title": "UpliftByFilterOperation",
      "type": "object"
    },
    "UpliftByFilterParameters": {
      "additionalProperties": false,
      "description": "`uplift_by_filter`'s parameters (04 §4.4): the percentage plus the key filter.",
      "properties": {
        "filter": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Filter",
          "type": "object"
        },
        "percentage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Percentage"
        }
      },
      "required": [
        "percentage",
        "filter"
      ],
      "title": "UpliftByFilterParameters",
      "type": "object"
    },
    "UpliftTableOperation": {
      "additionalProperties": false,
      "properties": {
        "applied_to": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "uplift_table",
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/UpliftTableParameters"
        },
        "result": {
          "$ref": "#/$defs/BulkOperationResult"
        }
      },
      "required": [
        "applied_to",
        "result",
        "kind",
        "parameters"
      ],
      "title": "UpliftTableOperation",
      "type": "object"
    },
    "UpliftTableParameters": {
      "additionalProperties": false,
      "description": "`uplift_table`'s parameters (04 §4.4): the percentage, applied to every cell.",
      "properties": {
        "percentage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Percentage"
        }
      },
      "required": [
        "percentage"
      ],
      "title": "UpliftTableParameters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A Rate Table Version (FR-229, FR-232, 03 §4.2).\n\nAn immutable version of one rate table, in the §4.2 wire form: the definition\n(`keys`, `value`, `default_row`), the cells (`rows` for row storage, `cells` as a\nparquet BlobRef above the threshold), the seed origin, and the creation metadata.\nEditing produces a new version with a required change note. The storage mode is\nfixed when the version is written and immutable with it (FR-232), and a version\nis created by a seed, an operation or an import — never more than one.",
  "properties": {
    "cells": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "change_note": {
      "title": "Change Note",
      "type": "string"
    },
    "created_by_edit": {
      "anyOf": [
        {
          "$ref": "#/$defs/ManualEdit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_by_import": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_by_operation": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "floor_and_cap": "#/$defs/FloorAndCapOperation",
              "rebase_to_level": "#/$defs/RebaseToLevelOperation",
              "uplift_by_filter": "#/$defs/UpliftByFilterOperation",
              "uplift_table": "#/$defs/UpliftTableOperation"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UpliftTableOperation"
            },
            {
              "$ref": "#/$defs/UpliftByFilterOperation"
            },
            {
              "$ref": "#/$defs/FloorAndCapOperation"
            },
            {
              "$ref": "#/$defs/RebaseToLevelOperation"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By Operation"
    },
    "default_row": {
      "anyOf": [
        {
          "$ref": "#/$defs/RateTableCell"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "keys": {
      "items": {
        "$ref": "#/$defs/RateTableKey"
      },
      "title": "Keys",
      "type": "array"
    },
    "rateable": {
      "title": "Rateable",
      "type": "boolean"
    },
    "rows": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RateTableCell"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows"
    },
    "seeded_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeededFrom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Slug",
      "type": "string"
    },
    "storage": {
      "$ref": "#/$defs/RateTableStorageMode"
    },
    "value": {
      "$ref": "#/$defs/RateTableValue"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "slug",
    "version",
    "rateable",
    "storage",
    "keys",
    "value",
    "change_note"
  ],
  "title": "RateTableVersion",
  "type": "object"
}
