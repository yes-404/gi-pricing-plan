{
  "$defs": {
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    },
    "GoldenQuote": {
      "additionalProperties": false,
      "description": "A named Quote Context with its expected outputs (03 §2, FR-260).",
      "properties": {
        "context": {
          "$ref": "#/$defs/QuoteContext"
        },
        "expected": {
          "$ref": "#/$defs/GoldenQuoteExpected"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Name",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "tolerance": {
          "$ref": "#/$defs/GoldenQuoteTolerance",
          "default": {
            "money_minor": 0
          }
        }
      },
      "required": [
        "name",
        "context",
        "expected"
      ],
      "title": "GoldenQuote",
      "type": "object"
    },
    "GoldenQuoteExpected": {
      "additionalProperties": false,
      "description": "What a golden quote must reproduce: the payable premium and the outcome only.\n\nNever `timing_ms` (RL-931). `payable_premium_minor` is the `payable_premium` ladder\nrung's `value_minor`, and it is null exactly when `outcome` is not `quoted`.",
      "properties": {
        "outcome": {
          "enum": [
            "quoted",
            "declined",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "payable_premium_minor": {
          "anyOf": [
            {
              "description": "Amount in minor units (pence/cents) of the workspace currency.",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payable Premium Minor"
        }
      },
      "required": [
        "payable_premium_minor",
        "outcome"
      ],
      "title": "GoldenQuoteExpected",
      "type": "object"
    },
    "GoldenQuoteTolerance": {
      "additionalProperties": false,
      "description": "The declared tolerance, in integer minor units. Default exact (FR-260).",
      "properties": {
        "money_minor": {
          "default": 0,
          "minimum": 0,
          "title": "Money Minor",
          "type": "integer"
        }
      },
      "title": "GoldenQuoteTolerance",
      "type": "object"
    },
    "LadderReconciles": {
      "additionalProperties": false,
      "description": "The premium ladder reconciles (FR-248).",
      "properties": {
        "kind": {
          "const": "ladder_reconciles",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LadderReconciles",
      "type": "object"
    },
    "MonotoneInInput": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "increasing",
            "decreasing"
          ],
          "title": "Direction",
          "type": "string"
        },
        "input": {
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "kind": {
          "const": "monotone",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "description": "Exact decimal as a string; never a binary float (FR-10).",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "strict": {
          "default": false,
          "title": "Strict",
          "type": "boolean"
        },
        "upper": {
          "anyOf": [
            {
              "description": "Exact decimal as a string; never a binary float (FR-10).",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "required": [
        "kind",
        "input",
        "direction"
      ],
      "title": "MonotoneInInput",
      "type": "object"
    },
    "NoNullOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "no_null_output",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoNullOutput",
      "type": "object"
    },
    "PremiumBounded": {
      "additionalProperties": false,
      "description": "An absolute bound, in minor units — never relative to another output.",
      "properties": {
        "kind": {
          "const": "premium_bounded",
          "title": "Kind",
          "type": "string"
        },
        "lower_minor": {
          "anyOf": [
            {
              "description": "Amount in minor units (pence/cents) of the workspace currency.",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Minor"
        },
        "upper_minor": {
          "anyOf": [
            {
              "description": "Amount in minor units (pence/cents) of the workspace currency.",
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Minor"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PremiumBounded",
      "type": "object"
    },
    "PremiumPositive": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "premium_positive",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PremiumPositive",
      "type": "object"
    },
    "QuoteContext": {
      "additionalProperties": false,
      "description": "`QuoteContext` (`scoring.schema.json:7-24`, `03` §4.4).",
      "properties": {
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "options": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteContextOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purpose": {
          "enum": [
            "new_business",
            "renewal",
            "mid_term_adjustment",
            "cancellation",
            "what_if"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "quote_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Id"
        },
        "quoted_at": {
          "format": "date-time",
          "title": "Quoted At",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "quoted_at",
        "effective_date"
      ],
      "title": "QuoteContext",
      "type": "object"
    },
    "QuoteContextOptions": {
      "additionalProperties": false,
      "description": "`QuoteContext.options` (`scoring.schema.json:16-22`).\n\n`trace` is **not** read by `score_one` — its own `trace: bool` keyword is the single\nsource (`03` §5.2's already-ruled signature, RL-868); this field exists because the\nwire contract declares it, for a caller (Slice 2's HTTP layer) that maps a request body\nonto the `trace=` argument. `rating_version_ref` is required in practice at this layer:\nSlice 1 builds no default-live resolution (DP1, Slice 2), so `score_one` refuses a\ncontext that omits it rather than guessing which version to report scoring against.",
      "properties": {
        "rating_version_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trace": {
          "default": false,
          "title": "Trace",
          "type": "boolean"
        }
      },
      "title": "QuoteContextOptions",
      "type": "object"
    },
    "RegressionGeneration": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "strategy": {
          "const": "input_contract_sampling",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "cases",
        "seed",
        "strategy"
      ],
      "title": "RegressionGeneration",
      "type": "object"
    },
    "RegressionProperty": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "discriminator": {
            "mapping": {
              "ladder_reconciles": "#/$defs/LadderReconciles",
              "monotone": "#/$defs/MonotoneInInput",
              "no_null_output": "#/$defs/NoNullOutput",
              "premium_bounded": "#/$defs/PremiumBounded",
              "premium_positive": "#/$defs/PremiumPositive"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PremiumPositive"
            },
            {
              "$ref": "#/$defs/MonotoneInInput"
            },
            {
              "$ref": "#/$defs/NoNullOutput"
            },
            {
              "$ref": "#/$defs/LadderReconciles"
            },
            {
              "$ref": "#/$defs/PremiumBounded"
            }
          ],
          "title": "Check"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "check"
      ],
      "title": "RegressionProperty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One version of a Regression Suite (03 §4.7). Versioned, not approvable.",
  "properties": {
    "algorithm_slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Algorithm Slug",
      "type": "string"
    },
    "change_note": {
      "minLength": 1,
      "title": "Change Note",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "format": "uuid",
      "title": "Created By",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/RegressionGeneration"
    },
    "golden_quotes": {
      "items": {
        "$ref": "#/$defs/GoldenQuote"
      },
      "title": "Golden Quotes",
      "type": "array"
    },
    "properties": {
      "items": {
        "$ref": "#/$defs/RegressionProperty"
      },
      "title": "Properties",
      "type": "array"
    },
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Slug",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "algorithm_slug",
    "golden_quotes",
    "properties",
    "generation",
    "slug",
    "version",
    "change_note",
    "content_hash",
    "created_at",
    "created_by"
  ],
  "title": "RegressionSuite",
  "type": "object"
}
