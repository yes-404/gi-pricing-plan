{
  "$defs": {
    "ArtifactRef": {
      "description": "Canonical artifact reference {type}:{slug}@{version} (ID-3).",
      "examples": [
        "model:motor-ad-frequency@7",
        "rating_version:motor-gb@27"
      ],
      "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$",
      "title": "ArtifactRef",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One approved Rating Version bound to one Environment at a point in time (`03` §4.12).",
  "properties": {
    "bundle_hash": {
      "description": "The Rating Version's compiled Bundle hash (FR-239).",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Bundle Hash",
      "type": "string"
    },
    "deployed_at": {
      "format": "date-time",
      "title": "Deployed At",
      "type": "string"
    },
    "deployed_by": {
      "format": "uuid",
      "title": "Deployed By",
      "type": "string"
    },
    "deployment_request_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The approved Deployment Request executed; null only for a target with no `deployment` policy entry (RL-1301 A.5)."
    },
    "environment": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "title": "Environment",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "rating_version_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "workspace_id",
    "environment",
    "rating_version_ref",
    "bundle_hash",
    "deployed_by",
    "deployed_at",
    "reason"
  ],
  "title": "Deployment",
  "type": "object"
}
