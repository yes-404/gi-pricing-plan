{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/job.schema.json",
  "title": "Job",
  "description": "Uniform lifecycle for every long-running operation. See 07-platform.md §4.1.",
  "type": "object",
  "required": [
    "id",
    "workspace_id",
    "kind",
    "status",
    "queue",
    "submitted_by",
    "source",
    "queued_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "dataset.ingest",
        "dataset.validate",
        "dataset.profile",
        "dataset.derive",
        "blob.promote",
        "model.fit",
        "model.transparency",
        "model.backtest",
        "model.compare",
        "peril_structure.reconcile",
        "objective.certify",
        "metric.certify",
        "rating.compile",
        "rating.regression",
        "rate_table.diff",
        "rate_table.diff_cells",
        "score.batch",
        "score.trace_produce",
        "dislocation.run",
        "optimisation.run",
        "gipp.check",
        "monitor.run",
        "dossier.generate",
        "export.regulatory",
        "blob.gc"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "queue": {
      "enum": [
        "default",
        "compute",
        "scoring",
        "io"
      ]
    },
    "submitted_by": {
      "type": "object"
    },
    "source": {
      "enum": [
        "ui",
        "api",
        "schedule",
        "system"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "progress": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stage": {
          "type": "string"
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "enum": [
            "artifact",
            "blob",
            "none"
          ]
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "detail": {
          "type": "object"
        },
        "location": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Where in the caller's own artifact a deterministic refusal points (#1917): identifiers only, never a submitted value. A key that is not set is null. At least one key is set: JSON Schema cannot say so while unset keys are null, so the model's own validator enforces it (`07` §4.1).",
          "properties": {
            "factor": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "feature": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "field": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "interaction": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "key": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "objective": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "operand": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "peril": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$"
            },
            "step_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]+$"
            },
            "structure": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^((banding|custom_metric|custom_objective|dataset|dataset_version|deployment|dossier|gipp_check|grouping|model|monitor|optimisation_run|peril_structure|rate_table|rating_algorithm|rating_version|reference_table|regression_suite|sub_graph|validation_rule|validation_rule_set):[a-z0-9][a-z0-9-]{1,62}|factor:[a-z0-9][a-z0-9_-]{1,62})@[1-9][0-9]*$"
            }
          }
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{32}$",
          "description": "W3C/OpenTelemetry trace id: 32 lowercase hex characters (00 §5.3)."
        }
      }
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "W3C/OpenTelemetry trace id: 32 lowercase hex characters (00 §5.3)."
    },
    "queued_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "resource_budget": {
      "type": "object",
      "properties": {
        "memory_gb": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wall_clock_s": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "description": "Exceeding the budget yields a typed error naming it, not an opaque OOM kill (FR-412)."
    },
    "retries": {
      "type": "object",
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "policy": {
          "enum": [
            "infrastructure_only",
            "none"
          ]
        }
      }
    },
    "platform_build": {
      "type": [
        "string",
        "null"
      ],
      "description": "The platform version and build the Job ran on, `{version}+{build}`, recorded when the worker moves it to `running`; null while `queued` (FR-18)."
    },
    "progress_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Time of the last progress report (NFR-528)."
    },
    "stalled": {
      "type": "boolean",
      "description": "Derived: a running Job with no progress within the configured window."
    }
  }
}
