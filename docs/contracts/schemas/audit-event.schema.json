{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/audit-event.schema.json",
  "title": "AuditEvent",
  "description": "Immutable append-only record. See 06-governance.md §4.5.",
  "type": "object",
  "required": ["id", "workspace_id", "at", "actor", "source", "action", "entity_ref", "event_hash"],
  "properties": {
    "id": {"type": "string"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "at": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["user", "service_account", "system"]},
        "id": {"type": ["string", "null"], "format": "uuid"},
        "display": {"type": "string"}
      }
    },
    "source": {"enum": ["ui", "api", "job", "system"]},
    "action": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
    "entity_ref": {"type": "string"},
    "before": {"type": ["object", "null"]},
    "after": {"type": ["object", "null"]},
    "justification": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$", "description": "W3C/OpenTelemetry trace id: 32 lowercase hex characters (00 §5.3)."},
    "job_id": {"type": ["string", "null"], "format": "uuid"},
    "prev_event_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "invariants": [
    "written in the same transaction as the change it records; if the audit write fails, the change fails (06 R2)",
    "never updated or deleted; the application role holds INSERT and SELECT only (FR-370)",
    "secrets and full quote inputs appear as references or hashes, never as values (FR-375)"
  ]
}
