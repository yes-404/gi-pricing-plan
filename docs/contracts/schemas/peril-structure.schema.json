{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gi-pricing.dev/peril-structure.schema.json",
  "title": "PerilStructure",
  "description": "Declarative composition of per-peril models into a Risk Premium. What a Rating Version references, rather than a scatter of individual models (02 FR-MODEL-58..61, §4.10).",
  "type": "object",
  "required": ["perils", "excluded_perils", "reconciliation"],
  "allOf": [{"$ref": "common/artifact-envelope.schema.json"}],
  "properties": {
    "perils": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["peril", "method", "large_loss"],
        "properties": {
          "peril": {"type": "string"},
          "method": {"enum": ["frequency_severity", "burning_cost"]},
          "frequency_model": {"$ref": "common/artifact-ref.schema.json"},
          "severity_model": {"$ref": "common/artifact-ref.schema.json"},
          "burning_cost_model": {"$ref": "common/artifact-ref.schema.json"},
          "large_loss": {
            "type": "object",
            "required": ["kind"],
            "description": "Whatever is chosen is recorded with its calibration evidence (FR-MODEL-59).",
            "properties": {
              "kind": {"enum": ["none", "capped", "separate_model", "flat_loading"]},
              "cap_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
              "restoration_loading": {"type": "number", "exclusiveMinimum": 0},
              "excess_model": {"$ref": "common/artifact-ref.schema.json"},
              "attachment_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
              "flat_loading_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
              "evidence_blob": {"type": ["string", "null"]}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"method": {"const": "frequency_severity"}}, "required": ["method"]},
           "then": {"required": ["frequency_model", "severity_model"]}},
          {"if": {"properties": {"method": {"const": "burning_cost"}}, "required": ["method"]},
           "then": {"required": ["burning_cost_model"]}},
          {"if": {"properties": {"large_loss": {"properties": {"kind": {"const": "capped"}}, "required": ["kind"]}}},
           "then": {"properties": {"large_loss": {"required": ["cap_minor", "restoration_loading"]}}}},
          {"if": {"properties": {"large_loss": {"properties": {"kind": {"const": "separate_model"}}, "required": ["kind"]}}},
           "then": {"properties": {"large_loss": {"required": ["excess_model", "attachment_minor"]}}}}
        ]
      }
    },
    "excluded_perils": {
      "type": "array",
      "description": "Every peril in the dataset is either modelled or explicitly excluded with a reason (FR-MODEL-60).",
      "items": {
        "type": "object",
        "required": ["peril", "reason"],
        "properties": {"peril": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}
      }
    },
    "reconciliation": {
      "type": "object",
      "required": ["dataset_version_id", "part", "observed_burning_cost_minor",
                   "modelled_burning_cost_minor", "ratio", "tolerance", "status"],
      "properties": {
        "dataset_version_id": {"type": "string", "format": "uuid"},
        "part": {"enum": ["train", "holdout", "full"]},
        "observed_burning_cost_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "modelled_burning_cost_minor": {"$ref": "common/money.schema.json#/$defs/MoneyMinor"},
        "ratio": {"type": "number", "exclusiveMinimum": 0},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "status": {"enum": ["pass", "fail"]}
      }
    }
  }
}
