{
  "components": {
    "schemas": {
      "ComponentHealth": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it is down. Never a secret (R3).",
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ComponentHealth",
        "type": "object"
      },
      "ComponentStatus": {
        "enum": [
          "up",
          "down"
        ],
        "title": "ComponentStatus",
        "type": "string"
      },
      "ReadinessReport": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            },
            "title": "Components",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ComponentStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "VersionInfo": {
        "additionalProperties": false,
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "environment"
        ],
        "title": "VersionInfo",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "GI Pricing Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Never touches a dependency. See the module docstring for why.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness — is the process alive?",
        "tags": [
          "platform"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Probe every registered dependency concurrently (FR-PLAT-41).",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness — can the process serve traffic?",
        "tags": [
          "platform"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service name, version and environment",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
