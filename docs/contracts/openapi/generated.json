    "/api/v1/jobs/{job_id}/events": {
      "get": {
        "description": "Server-sent events, so the UI shows progress where the action was taken (`07` §6).\n\nPolled rather than pushed. A `LISTEN`/`NOTIFY` subscription would hold a database\nconnection open per viewer, and a jobs page with twenty rows open in three browsers\nexhausts the pool. Polling one row on an interval is dull and survives a restart of\nanything.\n\nThe stream closes when the Job reaches a terminal state, so a client that forgets to\nunsubscribe does not hold the connection for ever.",
        "operationId": "stream_job_events_api_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
