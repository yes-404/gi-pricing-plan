{
  "name": "gi-pricing-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../docs/contracts/openapi/generated.json -o src/api/generated/schema.d.ts && openapi-typescript ../docs/contracts/openapi/generated.json --default-non-nullable false -o src/api/generated/schema.requests.d.ts",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/vue-table": "9.3.1",
    "@vue-flow/core": "1.48.2",
    "echarts": "^6.1.0",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
