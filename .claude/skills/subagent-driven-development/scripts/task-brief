#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# This repo's own `writing-plans` house pattern (docs/plans/2026-08-29-w11-scoring.md
# and its cited precedent docs/plans/2026-08-22-w5-audit-remediation.md) numbers tasks as
# "### 1.1 — Title" rather than upstream's "# Task 1" — a heading with no literal word
# "Task" at all. The original single-pattern match below silently exits 3 on every such
# plan (confirmed empirically, not assumed, 2026-08-29). Recognise both conventions.
# Regex metacharacters in the task number (the "." in "1.1") are escaped so they match
# literally rather than "any character".
n_re=$(printf '%s' "$n" | sed -e 's/[.[\*^$]/\\&/g')

# A house-pattern plan groups several "### N.M" tasks under "## Slice N" sections in one
# file (unlike a one-task-per-heading upstream plan), so the LAST task in a slice has no
# following task heading to stop at — confirmed empirically: without a boundary rule,
# task 1.5's brief ran on through the "## Slice 2" boundary into the next slice entirely.
#
# REGRESSION, found and fixed 2026-08-29 (reported by the lead, reproduced independently
# before touching anything: unpatched script on a synthetic "# Task 1" / "# Task 2" plan
# exits 0; the first version of this boundary fix exited 3 on the SAME input). Upstream's
# own "# Task N" heading is itself an H1, so a separate, unconditional
# `!infence && /^##?[ \t]/ { intask = 0 }` rule fired on that exact line, immediately
# clearing the flag the task-match rule above it had just set on the same record — awk runs
# every matching pattern-block against a line, in order, so the second block silently undid
# the first. Fixed by making the two mutually exclusive: the boundary-clear only applies
# when the heading did NOT already match a recognised task pattern.
awk -v n="$n_re" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]/ {
    if ($0 ~ /^#+[ \t]+Task[ \t]+[0-9]/ || $0 ~ /^#+[ \t]+[0-9]+\.[0-9]+([ \t]|$)/) {
      intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)")) \
            || ($0 ~ ("^#+[ \t]+" n "([^0-9.]|$)"))
    } else if ($0 ~ /^##?[ \t]/) {
      intask = 0
    }
  }
  intask { print }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}' or '${n} —')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
